<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Strength Analyzer</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <div class="container">

        <h1>Password Strength Analyzer</h1>
        <p class="subtitle">
            Check how strong your password is
        </p>

        <div class="password-box">
            <input
                type="password"
                id="password"
                placeholder="Enter your password"
                autocomplete="off"
            >

            <button id="togglePassword">Show</button>
        </div>

        <div class="strength-container">
            <div class="strength-bar">
                <div id="strengthBar"></div>
            </div>

            <h2 id="strengthText">Enter a password</h2>
        </div>

        <div class="checks">

            <p id="length">❌ At least 8 characters</p>

            <p id="uppercase">❌ Contains uppercase letter</p>

            <p id="lowercase">❌ Contains lowercase letter</p>

            <p id="number">❌ Contains a number</p>

            <p id="special">❌ Contains special character</p>

            <p id="unique">❌ Not a common/repeated password</p>

        </div>

        <div class="suggestions">
            <h3>Suggestions</h3>
            <p id="suggestion">
                Enter a password to get suggestions.
            </p>
        </div>

        <button id="generateBtn" class="generate">
            Generate Strong Password
        </button>

        <div class="generated">
            <input
                type="text"
                id="generatedPassword"
                readonly
                placeholder="Generated password"
            >
            <button id="copyBtn">Copy</button>
        </div>

    </div>

    <script src="script.js"></script>

</body>
</html>